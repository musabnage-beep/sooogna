rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // -----------------------------
    // Helpers
    // -----------------------------
    function isSignedIn() {
      return request.auth != null;
    }

    function isSelf(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function userDoc(userId) {
      return get(/databases/$(database)/documents/users/$(userId));
    }

    function isAdmin() {
      return isSignedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && userDoc(request.auth.uid).data.role == 'admin';
    }

    function isBanned() {
      return isSignedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && userDoc(request.auth.uid).data.isBanned == true;
    }

    function isValidString(v, minLen, maxLen) {
      return v is string && v.size() >= minLen && v.size() <= maxLen;
    }

    function ownsStore(storeId) {
      return isSignedIn()
        && exists(/databases/$(database)/documents/stores/$(storeId))
        && get(/databases/$(database)/documents/stores/$(storeId)).data.ownerId == request.auth.uid;
    }

    function unchanged(field) {
      return request.resource.data[field] == resource.data[field];
    }

    // Counter moved by exactly +1 or -1 and nothing else changed.
    function isCounterStep(field) {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly([field])
        && request.resource.data[field] is int
        && (request.resource.data[field] == resource.data[field] + 1
            || request.resource.data[field] == resource.data[field] - 1);
    }

    // Analytics summary bump: a single counter +1 alongside updatedAt only.
    // Prevents clients from SETTING counters to arbitrary (inflated) values.
    function isAnalyticsBump(field) {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly([field, 'updatedAt'])
        && request.resource.data[field] is int
        && request.resource.data[field] == resource.data[field] + 1;
    }

    // On first bump the doc is created via set(merge): the bumped counter
    // starts at 1, all others absent. Reject any pre-inflated create value.
    function isFreshAnalyticsCounter(field) {
      return !(field in request.resource.data)
        || (request.resource.data[field] is int
            && request.resource.data[field] >= 0
            && request.resource.data[field] <= 1);
    }

    // -----------------------------
    // Users
    // -----------------------------
    match /users/{userId} {
      // Single-document reads are public (needed to show seller info on ad
      // detail for guests). Collection-wide queries (`list`) are admin-only
      // — this blocks enumeration / phone harvesting while still allowing
      // anyone to view a specific seller profile.
      allow get: if true;
      allow list: if isAdmin();

      // Create own profile (phone auth)
      allow create: if isSelf(userId)
        && request.resource.data.id == userId
        && isValidString(request.resource.data.name, 2, 50)
        && request.resource.data.phone is string
        && request.resource.data.role == 'user'
        && request.resource.data.isBanned == false
        && request.resource.data.isVerified == false
        && (!('verifiedStatus' in request.resource.data)
            || request.resource.data.verifiedStatus == 'unverified');

      // Self update (limited fields). Verification, rating, analytics and
      // moderation fields can NEVER be self-set — only admins / server tx.
      allow update: if isSelf(userId)
        && !isBanned()
        && unchanged('id')
        && unchanged('phone')
        && unchanged('role')
        && unchanged('isBanned')
        && unchanged('isVerified')
        && (!('verifiedStatus' in request.resource.data) || unchanged('verifiedStatus'))
        && unchanged('rating')
        && unchanged('ratingCount')
        && (!('profileVisits' in request.resource.data) || unchanged('profileVisits'))
        && unchanged('createdAt');

      // Profile-visit counter: any signed-in user may bump it by 1.
      allow update: if isSignedIn() && isCounterStep('profileVisits');

      // Admin update (anything)
      allow update: if isAdmin();

      // Only admins can delete
      allow delete: if isAdmin();

      // Per-user notifications subcollection
      match /notifications/{notifId} {
        allow read: if isSelf(userId);
        allow update: if isSelf(userId)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['isRead']);
        allow create, delete: if isAdmin();
      }

      // Saved ads / favorites (Feature 8) — fully private to the owner.
      match /favorites/{adId} {
        allow read, create, delete: if isSelf(userId);
      }

      // Seller analytics summary (Feature 10). Owner + admin may read.
      // Counters may only be bumped +1 at a time by signed-in users
      // (view/contact/save/profileVisit) — never set to an arbitrary value.
      match /analytics/{docId} {
        allow read: if isSelf(userId) || isAdmin();
        allow create: if isSignedIn()
          && request.resource.data.keys().hasOnly(
              ['totalViews', 'totalContacts', 'totalSaved', 'profileVisits', 'updatedAt'])
          && isFreshAnalyticsCounter('totalViews')
          && isFreshAnalyticsCounter('totalContacts')
          && isFreshAnalyticsCounter('totalSaved')
          && isFreshAnalyticsCounter('profileVisits');
        allow update: if isSignedIn()
          && (isAnalyticsBump('totalViews')
              || isAnalyticsBump('totalContacts')
              || isAnalyticsBump('totalSaved')
              || isAnalyticsBump('profileVisits'));
      }
    }

    // -----------------------------
    // Ads
    // -----------------------------
    match /ads/{adId} {
      // Public may only see active ads. Owners see their own ads in any
      // status; admins see everything. Queries that don't constrain to
      // status=='active' are rejected for non-owner/non-admin callers.
      allow read: if resource.data.status == 'active'
        || (isSignedIn() && resource.data.userId == request.auth.uid)
        || isAdmin();

      allow create: if isSignedIn()
        && !isBanned()
        && request.resource.data.userId == request.auth.uid
        && isValidString(request.resource.data.title, 3, 100)
        && isValidString(request.resource.data.description, 10, 2000)
        && request.resource.data.price is number
        && request.resource.data.price >= 0
        && request.resource.data.category is string
        && request.resource.data.location is string
        && request.resource.data.images is list
        && request.resource.data.images.size() >= 1
        && request.resource.data.images.size() <= 10
        && request.resource.data.status == 'pending'
        && request.resource.data.isFeatured == false
        && request.resource.data.viewCount == 0
        && (!('contactCount' in request.resource.data) || request.resource.data.contactCount == 0)
        && (!('ownerType' in request.resource.data)
            || request.resource.data.ownerType in ['owner', 'broker', 'company'])
        // A store may only be attached by that store's owner.
        && (!('storeId' in request.resource.data)
            || request.resource.data.storeId == null
            || ownsStore(request.resource.data.storeId));

      // Owner update (non-moderation fields). Counters cannot be hand-edited.
      allow update: if isSignedIn()
        && !isBanned()
        && resource.data.userId == request.auth.uid
        && request.resource.data.userId == resource.data.userId
        && unchanged('isFeatured')
        && unchanged('viewCount')
        && unchanged('favoriteCount')
        && (!('contactCount' in request.resource.data) || unchanged('contactCount'))
        && (!('storeId' in request.resource.data)
            || request.resource.data.storeId == resource.data.storeId
            || request.resource.data.storeId == null
            || ownsStore(request.resource.data.storeId))
        && (request.resource.data.status == resource.data.status
            || request.resource.data.status == 'sold'
            || request.resource.data.status == 'pending');

      // View counter increment by any signed-in user (+1 only)
      allow update: if isSignedIn()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['viewCount'])
        && request.resource.data.viewCount == resource.data.viewCount + 1;

      // Contact counter increment by any signed-in user (+1 only)
      allow update: if isSignedIn()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['contactCount'])
        && request.resource.data.contactCount == resource.data.contactCount + 1;

      // Favorite counter step (+1 on save / -1 on unsave) by any signed-in user
      allow update: if isSignedIn() && isCounterStep('favoriteCount');

      // Admin full control
      allow update, delete: if isAdmin();

      // Owner delete
      allow delete: if isSignedIn()
        && resource.data.userId == request.auth.uid;
    }

    // -----------------------------
    // Chats
    // -----------------------------
    match /chats/{chatId} {
      allow read: if isSignedIn()
        && request.auth.uid in resource.data.userIds;

      allow create: if isSignedIn()
        && !isBanned()
        && request.auth.uid in request.resource.data.userIds
        && request.resource.data.userIds.size() == 2;

      allow update: if isSignedIn()
        && !isBanned()
        && request.auth.uid in resource.data.userIds
        && request.resource.data.userIds == resource.data.userIds;

      allow delete: if isAdmin();

      match /messages/{messageId} {
        function chatParticipants() {
          return get(/databases/$(database)/documents/chats/$(chatId)).data.userIds;
        }

        allow read: if isSignedIn() && request.auth.uid in chatParticipants();

        allow create: if isSignedIn()
          && !isBanned()
          && request.auth.uid in chatParticipants()
          && request.resource.data.senderId == request.auth.uid
          && (
            (request.resource.data.type == 'text'
              && request.resource.data.text is string
              && request.resource.data.text.size() >= 1
              && request.resource.data.text.size() <= 4000)
            || (request.resource.data.type == 'image'
              && request.resource.data.image is string)
          );

        // Only allow marking as read
        allow update: if isSignedIn()
          && request.auth.uid in chatParticipants()
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['isRead'])
          && request.resource.data.isRead == true;

        allow delete: if isAdmin();
      }
    }

    // -----------------------------
    // Reviews
    // -----------------------------
    match /reviews/{reviewId} {
      allow read: if true;

      // One review per (reviewer, target): the document ID is forced to
      // "{reviewerId}_{targetId}", so a second review collides and becomes an
      // update (allowed only for the original reviewer = editing).
      // Backward compatible: legacy user reviews used the `userId` field.
      allow create: if isSignedIn()
        && !isBanned()
        && request.resource.data.reviewerId == request.auth.uid
        && request.resource.data.rating is number
        && request.resource.data.rating >= 1
        && request.resource.data.rating <= 5
        && isValidString(request.resource.data.comment, 0, 500)
        && (!('targetType' in request.resource.data)
            || request.resource.data.targetType in ['user', 'service', 'store'])
        && (
          (('targetId' in request.resource.data)
            && reviewId == request.resource.data.reviewerId + '_' + request.resource.data.targetId
            && request.resource.data.targetId != request.auth.uid)
          ||
          (!('targetId' in request.resource.data)
            && ('userId' in request.resource.data)
            && reviewId == request.resource.data.reviewerId + '_' + request.resource.data.userId
            && request.resource.data.userId != request.auth.uid)
        );

      allow update, delete: if isAdmin()
        || (isSignedIn() && resource.data.reviewerId == request.auth.uid);
    }

    // -----------------------------
    // Reports
    // -----------------------------
    match /reports/{reportId} {
      allow read: if isAdmin();

      allow create: if isSignedIn()
        && !isBanned()
        && request.resource.data.reporterId == request.auth.uid
        && isValidString(request.resource.data.reason, 1, 500)
        && request.resource.data.isResolved == false;

      allow update, delete: if isAdmin();
    }

    // -----------------------------
    // Service profiles (Feature 1) — docId == userId
    // -----------------------------
    match /services/{providerId} {
      allow read: if true;

      allow create: if isSelf(providerId)
        && !isBanned()
        && request.resource.data.userId == providerId
        && isValidString(request.resource.data.profession, 1, 60)
        && isValidString(request.resource.data.description, 1, 2000)
        && request.resource.data.rating == 0
        && request.resource.data.ratingCount == 0
        && (!('verifiedStatus' in request.resource.data)
            || request.resource.data.verifiedStatus == 'unverified');

      // Owner edits, but can never self-set rating or verification.
      allow update: if isSelf(providerId)
        && !isBanned()
        && unchanged('userId')
        && unchanged('rating')
        && unchanged('ratingCount')
        && (!('verifiedStatus' in request.resource.data) || unchanged('verifiedStatus'));

      // Rating aggregate is written by the review transaction (any signed-in
      // reviewer) and only touches rating + ratingCount.
      allow update: if isSignedIn()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['rating', 'ratingCount']);

      allow update, delete: if isAdmin();
      allow delete: if isSelf(providerId);
    }

    // -----------------------------
    // Service requests (Feature 2)
    // -----------------------------
    match /serviceRequests/{requestId} {
      allow read: if true;

      allow create: if isSignedIn()
        && !isBanned()
        && request.resource.data.userId == request.auth.uid
        && isValidString(request.resource.data.title, 3, 100)
        && isValidString(request.resource.data.description, 10, 2000)
        && (!('budget' in request.resource.data)
            || request.resource.data.budget == null
            || (request.resource.data.budget is number && request.resource.data.budget >= 0))
        && request.resource.data.city is string
        && request.resource.data.category is string
        && request.resource.data.status == 'open'
        && request.resource.data.responseCount == 0;

      // Owner edits (status/title/etc.), counter frozen here.
      allow update: if isSignedIn()
        && resource.data.userId == request.auth.uid
        && unchanged('userId')
        && unchanged('responseCount');

      // responseCount +1 when a provider responds.
      allow update: if isSignedIn() && isCounterStep('responseCount');

      allow update, delete: if isAdmin();
      allow delete: if isSignedIn() && resource.data.userId == request.auth.uid;

      match /responses/{responseId} {
        allow read: if true;

        allow create: if isSignedIn()
          && !isBanned()
          && request.resource.data.providerId == request.auth.uid
          && isValidString(request.resource.data.message, 1, 1000)
          && (!('price' in request.resource.data) || request.resource.data.price is number);

        allow update, delete: if isAdmin()
          || (isSignedIn() && resource.data.providerId == request.auth.uid);
      }
    }

    // -----------------------------
    // Business stores (Feature 7) — docId == storeId
    // -----------------------------
    match /stores/{storeId} {
      allow read: if true;

      allow create: if isSignedIn()
        && !isBanned()
        && request.resource.data.ownerId == request.auth.uid
        && isValidString(request.resource.data.name, 2, 80)
        && request.resource.data.rating == 0
        && request.resource.data.ratingCount == 0;

      allow update: if isSignedIn()
        && resource.data.ownerId == request.auth.uid
        && unchanged('ownerId')
        && unchanged('rating')
        && unchanged('ratingCount');

      // productCount maintenance (+1/-1) and rating aggregate by signed-in users.
      allow update: if isSignedIn() && isCounterStep('productCount');
      allow update: if isSignedIn()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['rating', 'ratingCount']);

      allow update, delete: if isAdmin();
      allow delete: if isSignedIn() && resource.data.ownerId == request.auth.uid;
    }

    // -----------------------------
    // Identity verification requests (Feature 3)
    // -----------------------------
    match /verificationRequests/{userId} {
      allow get: if isSelf(userId) || isAdmin();
      allow list: if isAdmin();

      allow create, update: if isSelf(userId)
        && !isBanned()
        && request.resource.data.userId == userId
        && request.resource.data.requestedStatus in ['verified', 'premium']
        && request.resource.data.status == 'pending';

      // Only admins resolve requests (approve/reject); the badge itself is set
      // on the user doc by the admin update rule, never self-set.
      allow update, delete: if isAdmin();
    }
  }
}
