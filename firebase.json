{
  "firestore": {
    "rules": "souq_sudan/firebase/firestore.rules",
    "indexes": "souq_sudan/firebase/firestore.indexes.json"
  },
  "storage": {
    "rules": "souq_sudan/firebase/storage.rules"
  },
  "functions": [
    {
      "source": "functions",
      "codebase": "default",
      "runtime": "nodejs20",
      "predeploy": [
        "npm --prefix \"$RESOURCE_DIR\" run lint",
        "npm --prefix \"$RESOURCE_DIR\" run build"
      ]
    }
  ]
}
